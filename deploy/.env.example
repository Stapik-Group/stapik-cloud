# Copy to .env and fill in real values. Never commit .env to the repo.

POSTGRES_DB=stapik_cloud
POSTGRES_USER=stapik
POSTGRES_PASSWORD=changeme

# Generate a long random secret, e.g.: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# At-rest encryption keys, comma-separated <id>:<base64 32-byte key>. Generate one with: openssl rand -base64 32
# Keep a copy outside the server: without the key the stored documents and assets cannot be read.
# To rotate: add a new "<id>:<key>" entry, point ENCRYPTION_ACTIVE_KEY_ID at it and keep the old entries.
ENCRYPTION_KEYS=1:changeme-generate-a-32-byte-base64-key
ENCRYPTION_ACTIVE_KEY_ID=1

# Admin panel origin(s) (Next.js), comma-separated if more than one
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# First admin account bootstrap - leave blank after the first run
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme

AUDIT_RETENTION_DAYS=365