# Copy to .env and fill in real values. Never commit .env to the repo.

POSTGRES_DB=stapik_cloud
POSTGRES_USER=stapik
POSTGRES_PASSWORD=changeme

# Generate a long random secret, e.g.: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# Admin panel origin(s) (Next.js), comma-separated if more than one
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# First admin account bootstrap - leave blank after the first run
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme

AUDIT_RETENTION_DAYS=365